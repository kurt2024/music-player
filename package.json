{
"name": "dyt-music-player",
"version": "1.0.0",
"description": "HTML5, CSS3 ve JavaScript ile geliştirilmiş modern, responsive ve Capacitor uyumlu müzik çalar uygulaması.",
"main": "index.html",
"scripts": {
"start": "npx serve .",
"build": "mkdir -p dist && cp index.html dist/ 2>/dev/null || copy index.html dist\",
"cap:init": "cap init",
"cap:add:android": "cap add android",
"cap:add:ios": "cap add ios",
"cap:sync": "cap sync",
"cap:open:android": "cap open android",
"cap:open:ios": "cap open ios"
},
"keywords": [
"music-player",
"capacitor",
"audio-player",
"javascript",
"pwa",
"mobile-app"
 ],
"author": "Dyt. Fikret Kurt",
"license": "MIT",
"dependencies": {
"@capacitor/android": "^6.0.0",
"@capacitor/app": "^6.0.0",
"@capacitor/cli": "^6.0.0",
"@capacitor/core": "^6.0.0",
"@capacitor/filesystem": "^6.0.0",
"@capacitor/haptics": "^6.0.0",
"@capacitor/ios": "^6.0.0",
"@capacitor/share": "^6.0.0",
"@capacitor/status-bar": "^6.0.0"
},
"devDependencies": {
"typescript": "^5.0.0"
}
}